generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id           String       @id @default(cuid())
  agentId      Int?         @unique
  name         String
  description  String
  category     Category
  subcategory  String?
  version      String       @default("1.0.0")
  endpoint     String
  pricingModel PricingModel
  priceUsdc    String       @default("0")
  permissions  String[]
  logoUrl      String?
  metadataHash String
  ownerAddress String
  badgeTier    BadgeTier    @default(NONE)
  active       Boolean      @default(true)
  verifiedAt   DateTime?
  failedChecks Int          @default(0)
  registeredAt DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  txHash       String?
  aboutSchema  Json?
  phase2Ready  Boolean      @default(false)
  aboutCachedAt DateTime?

  builder Builder @relation(fields: [ownerAddress], references: [address])

  @@index([category])
  @@index([ownerAddress])
  @@index([active])
  @@index([badgeTier])
}

model Flow {
  id             String      @id @default(cuid())
  jobId          String      @unique
  callerAddress  String
  totalAmountUsdc String       @default("0")
  deadline       DateTime
  trigger        TriggerType
  triggerValue   String?
  status         FlowStatus  @default(LOCKED)
  paymentTxHash  String?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  agents         FlowAgent[]

  @@index([callerAddress])
  @@index([status])
}

model FlowAgent {
  id           String         @id @default(cuid())
  flowId       String
  agentId      Int
  agentAddress String
  orderIndex   Int
  amountUsdc   String       @default("0")
  staticInputs Json?
  inputMapping Json?
  status       AgentJobStatus @default(PENDING)
  output       Json?
  executedAt   DateTime?

  flow Flow @relation(fields: [flowId], references: [id])

  @@index([flowId])
  @@index([orderIndex])
}

enum FlowStatus {
  LOCKED
  RUNNING
  COMPLETED
  REFUNDED
  FAILED
}

enum AgentJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TriggerType {
  IMMEDIATE
  SCHEDULED
  CONDITION
}

model Builder {
  address       String   @id
  agentsCount   Int      @default(0)
  totalEarnings String   @default("0")
  joinedAt      DateTime @default(now())
  agents        Agent[]
}

model VerificationLog {
  id            String   @id @default(cuid())
  agentId       Int
  endpoint      String
  success       Boolean
  statusCode    Int?
  responseTimeMs Int?
  checkedAt     DateTime @default(now())

  @@index([agentId])
  @@index([checkedAt])
}

enum Category {
  DEFI
  TRADING
  DATA
  PRODUCTIVITY
  UTILITY
  SECURITY
  GAMING
  SOCIAL
}

enum PricingModel {
  PER_CALL
  PER_DAY
  PER_MONTH
  FREE
}

enum BadgeTier {
  NONE
  BRONZE
  SILVER
  GOLD
}

model Notification {
  id        String   @id @default(cuid())
  address   String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([address, read])
}

model ApiKey {
  id         String           @id @default(cuid())
  keyHash    String           @unique
  preview    String
  address    String
  name       String           @default("Default")
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  activity   APIKeyActivity[]

  @@index([address, active])
  @@index([keyHash])
}

model APIKeyActivity {
  id        String   @id @default(cuid())
  keyId     String
  action    String
  createdAt DateTime @default(now())

  apiKey    ApiKey   @relation(fields: [keyId], references: [id])

  @@index([keyId])
}
